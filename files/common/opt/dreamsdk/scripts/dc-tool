#!/usr/bin/env bash

if [ -z "${DREAMSDK_BASE_TOOLCHAINS}" ]; then
  echo "fatal: \$DREAMSDK_BASE_TOOLCHAINS is undefined!";
  exit 1;
fi

if [ ! -f "${DREAMSDK_CFG_DCTOOL}" ]; then
  echo "fatal: Dreamcast Tool configuration file not found: \"${DREAMSDK_CFG_DCTOOL}\"";
  exit 1;
fi

# Read a dc-tool parameter: the key must match exactly (e.g.,
# "MediaAccessControlAddress" vs. "HostMediaAccessControlAddress"), the value
# may contain "=" and the file may have CRLF line endings
get_parameter() {
  awk -v key="$1" '{ sub(/\r$/, ""); } index($0, key "=") == 1 { print substr($0, length(key) + 2); exit; }' "${DREAMSDK_CFG_DCTOOL}"
}

# Get dc-tool parameters
kind=$(get_parameter Kind)
executable=$(get_parameter Executable)
commandline=$(get_parameter CommandLine)
dreamcast_ip=$(get_parameter InternetProtocolAddress)
dreamcast_mac=$(get_parameter MediaAccessControlAddress)
host_mac=$(get_parameter HostMediaAccessControlAddress)
use_arp=$(get_parameter MediaAccessControlEnabled)

dreamcast_tool_not_configured() {
  echo "Dreamcast Tool (dc-tool) is not configured."
  echo "Please run DreamSDK Manager to do the configuration."
  echo "You may type \"dreamsdk manage\" to do that."  
  exit 1
}

# check the executable presence and the good configuration
is_executable_exists=$(command -v $executable)
if [ "$kind" == "0" ] || [ -z "$is_executable_exists" ]; then
  dreamcast_tool_not_configured
fi

# Handle arp
if [ "$kind" == "2" ] && [ "$use_arp" == "1" ]; then
  fastping ${dreamcast_ip}
  if [ $? -ne 0 ]; then
    is_uac_enabled=$(uac-status)
    if [ "$is_uac_enabled" == "1" ]; then    
      echo "Please confirm UAC to allow the ARP entry addition..."
    fi
	fastarp ${host_mac} ${dreamcast_ip} ${dreamcast_mac}
  fi
fi

# Handle user params

# Thanks: https://stackoverflow.com/a/1683850/3726096
trim()
{
    local trimmed="$1"

    # Strip leading spaces.
    while [[ $trimmed == ' '* ]]; do
       trimmed="${trimmed## }"
    done
    # Strip trailing spaces.
    while [[ $trimmed == *' ' ]]; do
        trimmed="${trimmed%% }"
    done

    echo "$trimmed"
}

# Thanks: https://stackoverflow.com/a/1669493/3726096
userparams=""
whitespace="[[:space:]]"
for i in "$@"
do
    if [[ $i =~ $whitespace ]]
    then
        i=\"$i\"
    fi
    userparams+="$i "
done

# run the loader!
dctool_cmd="${executable} ${commandline} $(trim "${userparams}")"
bash -c "${dctool_cmd}"
