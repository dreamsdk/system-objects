maybe_init_dreamsdk ()
{
  # File whose modification time mirrors the one of pacman.log when the useless
  # MSYS2 directories/files were last hidden
  local LASTDATEFILE="/etc/dreamsdk/pacman.stamp"

  # Hide useless MSYS2 directories/files but without removing them, as this is
  # better supported by pacman while upgrading packages
  _hide_useless_objects ()
  {
    local PACMAN_LOG="/var/log/pacman.log"

    # If pacman.log is new or updated (i.e. its modification time differs from
    # the stamp file), or does not exist at all, run the operation. Both "-nt"
    # and "-ot" are checked, as reinstalling DreamSDK may restore an older
    # pacman.log. This check uses Bash builtins only, as spawning processes is
    # slow on Windows and this runs on each login.
    if [[ ! -e "$PACMAN_LOG" || ! -f "$LASTDATEFILE" || "$PACMAN_LOG" -nt "$LASTDATEFILE" || "$PACMAN_LOG" -ot "$LASTDATEFILE" ]]; then
      # Hide MSYS2-related files and directories if they exist
      local USELESSOBJECTS=(
        "/autorebase.bat" "/msys2_shell.cmd"
        "/clang32" "/clang32.exe" "/clang32.ico" "/clang32.ini"
        "/clang64" "/clang64.exe" "/clang64.ico" "/clang64.ini"
        "/clangarm64" "/clangarm64.exe" "/clangarm64.ico" "/clangarm64.ini"
        "/mingw32" "/mingw32.exe" "/mingw32.ico" "/mingw32.ini"
        "/mingw64.exe" "/mingw64.ico" "/mingw64.ini"
        "/msys2.exe" "/msys2.ico" "/msys2.ini"
        "/ucrt64" "/ucrt64.exe" "/ucrt64.ico" "/ucrt64.ini"
      )

      for ELEMENT in "${USELESSOBJECTS[@]}"; do    
        if [[ -e "$ELEMENT" ]]; then
          attrib +h "$ELEMENT"
        fi
      done

      # Copy the modification time of pacman.log to the stamp file, unless
      # pacman.log doesn't exist: in that case, the operation is forced on each
      # login
      if [[ -e "$PACMAN_LOG" ]]; then
        touch -r "$PACMAN_LOG" "$LASTDATEFILE"
      fi
    fi
  }
  _hide_useless_objects

  # Check if a file contains a string, using Bash builtins only (like above,
  # this avoids spawning a "grep" process on each login)
  _file_contains ()
  {
    local CONTENT
    IFS= read -r -d '' CONTENT < "$1"
    [[ "$CONTENT" == *"$2"* ]]
  }

  # Set MSYSTEM default to "MINGW64" instead of "MSYS"
  local MSYSTEMFILE=/etc/msystem
  if _file_contains "${MSYSTEMFILE}" "{MSYSTEM:-MSYS}";
  then
    sed -i 's/{MSYSTEM:-MSYS}/{MSYSTEM:-MINGW64}/' "${MSYSTEMFILE}"
  fi

  # Set MSYS2_PATH_TYPE default to "inherit" instead of "minimal"
  local PROFILEFILE=/etc/profile
  if _file_contains "${PROFILEFILE}" "{MSYS2_PATH_TYPE:-minimal}";
  then
    sed -i 's/{MSYS2_PATH_TYPE:-minimal}/{MSYS2_PATH_TYPE:-inherit}/' "${PROFILEFILE}"
    # DreamSDK was just (re)installed: reinstalling the same version restores
    # pacman.log with the same modification time, so force hiding the useless
    # MSYS2 directories/files on the next login
    rm -f "$LASTDATEFILE"
    # This is not really nice, as this will close the shell the first time
    logout
  fi
}

maybe_init_dreamsdk
